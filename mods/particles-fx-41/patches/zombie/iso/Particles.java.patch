+      this.particleData.putFloat(screenY);
+      this.particleData.putFloat(this.spawnT[i]);
+      this.particleData.putFloat(this.hash[i]);
+      if (this.necroidUsesTint) {
+         zombie.necroid.particles.NecroidParticleLighting.sampleTint(this.tileX[i], this.tileY[i], (int)Math.floor(this.z[i]), this.tintScratch, 0);
+         this.particleData.putFloat(this.tintScratch[0]);
+         this.particleData.putFloat(this.tintScratch[1]);
+         this.particleData.putFloat(this.tintScratch[2]);
