+   }
+
+   public void ageParticles() {
+      if (this.necroidMaxParticles == 0) return;
+      float t = this.getShaderTime();
+      this.activeTiles.clear();
+      for (int i = 0; i < this.necroidMaxParticles; i++) {
+         if (!this.alive[i]) continue;
+         float age = t - this.spawnT[i];
+         if (age >= this.necroidLifetime || age < 0.0F) {
+            this.alive[i] = false;
+         } else {
+            this.activeTiles.add(packKey(this.tileX[i], this.tileY[i]));
+         }
+      }
+   }
+
+   protected static long packKey(int tx, int ty) {
+      return ((long)tx << 32) | ((long)ty & 0xFFFFFFFFL);
+   }
+
+   public boolean hasTile(int tx, int ty) {
+      return this.activeTiles.contains(packKey(tx, ty));
+   }
