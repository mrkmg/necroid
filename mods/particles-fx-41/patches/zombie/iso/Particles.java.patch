+
+   private void bindAttribPointers() {
+      GL20.glEnableVertexAttribArray(1);
+      GL20.glVertexAttribPointer(1, 4, 5126, false, this.necroidStride, 0L);
+      GL33.glVertexAttribDivisor(1, 1);
+      if (this.necroidUsesTint) {
+         GL20.glEnableVertexAttribArray(2);
+         GL20.glVertexAttribPointer(2, 4, 5126, false, this.necroidStride, 16L);
