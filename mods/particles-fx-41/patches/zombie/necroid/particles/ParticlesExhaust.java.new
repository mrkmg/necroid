package zombie.necroid.particles;

import zombie.iso.IsoCell;
import zombie.iso.Particles;

import zombie.core.Rand;

public final class ParticlesExhaust extends Particles {
   private static final int    MAX_PARTICLES = 512;
   private static final float  LIFETIME      = 1.8F;
   private static final String SHADER_NAME   = "necroid_exhaust";

   private static final String VERT_SRC =
      "#version 330\n" +
      "uniform mat4 mvpMatrix;\n" +
      "uniform float currentTime;\n" +
      "uniform float lifetime;\n" +
      "layout (location = 0) in vec3 Vertex;\n" +
      "layout (location = 1) in vec4 Particule;\n" +
      "layout (location = 2) in vec4 Tint;\n" +
      "varying vec2 texCoord;\n" +
      "varying float alpha;\n" +
      "varying float life;\n" +
      "varying vec4 vTint;\n" +
      "void main() {\n" +
      "   vTint = Tint;\n" +
      "   float age = currentTime - Particule.z;\n" +
      "   life = age / lifetime;\n" +
      "   if (life < 0.0 || life >= 1.0) {\n" +
      "      gl_Position = vec4(2.0, 2.0, 2.0, 1.0);\n" +
      "      alpha = 0.0;\n" +
      "      return;\n" +
      "   }\n" +
      "   float size = 10.0 + life * 22.0;\n" +
      "   float rot = Particule.w * 6.2831853 + life * 0.6;\n" +
      "   float c = cos(rot); float s = sin(rot);\n" +
      "   vec2 v = vec2(Vertex.x * c - Vertex.y * s, Vertex.x * s + Vertex.y * c);\n" +
      "   gl_Position = mvpMatrix * vec4(Particule.x + v.x * size, Particule.y + v.y * size, 0.0, 1.0);\n" +
      "   texCoord = Vertex.xy * 0.5 + 0.5;\n" +
      "   float fadeIn = clamp(life * 5.0, 0.0, 1.0);\n" +
      "   float fadeOut = 1.0 - life;\n" +
      "   alpha = fadeIn * fadeOut;\n" +
      "}\n";

   private static final String FRAG_SRC =
      "#version 330\n" +
      "varying vec2 texCoord;\n" +
      "varying float alpha;\n" +
      "varying float life;\n" +
      "varying vec4 vTint;\n" +
      "void main() {\n" +
      "   vec2 d = texCoord - vec2(0.5);\n" +
      "   float r = dot(d, d) * 4.0;\n" +
      "   float intensity = max(0.0, 1.0 - r);\n" +
      "   intensity = pow(intensity, 1.5);\n" +
      "   float shade = mix(0.30, 0.55, life);\n" +
      "   vec3 col = vec3(shade) * vTint.rgb;\n" +
      "   gl_FragColor = vec4(col, intensity * alpha * 0.45 * vTint.a);\n" +
      "}\n";

   private static ParticlesExhaust instance;

   public static synchronized ParticlesExhaust getInstance() {
      if (instance == null) {
         instance = new ParticlesExhaust();
      }
      return instance;
   }

   private ParticlesExhaust() {
      super(new Particles.Config(MAX_PARTICLES, LIFETIME,
         /*usesTint=*/true, /*blendSrc=*/770, /*blendDst=*/771,
         SHADER_NAME, VERT_SRC, FRAG_SRC));
   }

   /** Spawn an exhaust puff at (spawnX, spawnY, spawnZ) — caller is responsible for
    *  positioning at the rear-edge tailpipe. (driftX, driftY) is a unit vector pointing
    *  AWAY from the vehicle (the direction the puff should drift). Each particle's
    *  dispatch tile is locked to the integer tile of its visual spawn position so the
    *  puff keeps rendering after the vehicle drives off — see hasTile(), read by IsoCell
    *  to keep that tile in the per-frame dispatch set. */
   public void spawn(float spawnX, float spawnY, float spawnZ, float driftX, float driftY, int count) {
      float t = this.getShaderTime();
      for (int i = 0; i < count; i++) {
         int idx = this.writeIdx;
         this.writeIdx = (this.writeIdx + 1) % MAX_PARTICLES;
         float px = spawnX + Rand.Next(-0.06F, 0.06F);
         float py = spawnY + Rand.Next(-0.06F, 0.06F);
         this.x[idx] = px;
         this.y[idx] = py;
         this.z[idx] = spawnZ + Rand.Next(0.0F, 0.15F);
         int tx = (int)Math.floor(px);
         int ty = (int)Math.floor(py);
         this.tileX[idx] = tx;
         this.tileY[idx] = ty;
         this.activeTiles.add(packKey(tx, ty));
         this.spawnT[idx] = t + i * 0.015F;
         this.hash[idx] = Rand.Next(0.0F, 1.0F);
         float jx = Rand.Next(-0.1F, 0.1F);
         float jy = Rand.Next(-0.1F, 0.1F);
         this.vx[idx] = driftX * 0.15F + jx;
         this.vy[idx] = driftY * 0.15F + jy;
         this.vz[idx] = Rand.Next(0.3F, 0.55F);
         this.spawnWindAccumX[idx] = NecroidParticleWind.accumX();
         this.spawnWindAccumY[idx] = NecroidParticleWind.accumY();
         this.alive[idx] = true;
      }
   }
}
