package zombie.necroid.particles;

import zombie.iso.Particles;

import zombie.core.Rand;

public final class ParticlesFlame extends Particles {
   private static final int    MAX_PARTICLES = 1024;
   private static final float  LIFETIME      = 0.6F;
   private static final String SHADER_NAME   = "necroid_flame";

   /** Wind effect on the flame body — small sway, not translation. */
   private static final float CORE_WIND_FACTOR  = 0.22F;
   /** Sparks drift like smoke. */
   private static final float SPARK_WIND_FACTOR = 1.0F;

   // Hash encoding: w in [0.0, 0.5) = "core" flame (low rise, larger, peak-and-shrink).
   //                w in [0.5, 1.0) = "spark"     (fast rise, small, rare).
   private static final String VERT_SRC =
      "#version 330\n" +
      "uniform mat4 mvpMatrix;\n" +
      "uniform float currentTime;\n" +
      "uniform float lifetime;\n" +
      "layout (location = 0) in vec3 Vertex;\n" +
      "layout (location = 1) in vec4 Particule;\n" +
      "varying vec2 texCoord;\n" +
      "varying float alpha;\n" +
      "varying float life;\n" +
      "varying float isSpark;\n" +
      "void main() {\n" +
      "   float age = currentTime - Particule.z;\n" +
      "   life = age / lifetime;\n" +
      "   if (life < 0.0 || life >= 1.0) {\n" +
      "      gl_Position = vec4(2.0, 2.0, 2.0, 1.0);\n" +
      "      alpha = 0.0;\n" +
      "      return;\n" +
      "   }\n" +
      "   isSpark = step(0.5, Particule.w);\n" +
      "   float h = isSpark > 0.5 ? Particule.w - 0.5 : Particule.w;\n" +
      "   float coreSize  = 6.0 + sin(life * 3.14159) * 8.0;\n" +
      "   float sparkSize = 3.5 * (1.0 - life * 0.6);\n" +
      "   float size = mix(coreSize, sparkSize, isSpark);\n" +
      "   float rot = h * 12.566 + life * 1.2;\n" +
      "   float c = cos(rot); float s = sin(rot);\n" +
      "   vec2 v = vec2(Vertex.x * c - Vertex.y * s, Vertex.x * s + Vertex.y * c);\n" +
      "   gl_Position = mvpMatrix * vec4(Particule.x + v.x * size, Particule.y + v.y * size, 0.0, 1.0);\n" +
      "   texCoord = Vertex.xy * 0.5 + 0.5;\n" +
      "   float fadeIn = clamp(life * 8.0, 0.0, 1.0);\n" +
      "   float fadeOut = 1.0 - life;\n" +
      "   alpha = fadeIn * fadeOut;\n" +
      "}\n";

   private static final String FRAG_SRC =
      "#version 330\n" +
      "varying vec2 texCoord;\n" +
      "varying float alpha;\n" +
      "varying float life;\n" +
      "varying float isSpark;\n" +
      "void main() {\n" +
      "   vec2 d = texCoord - vec2(0.5);\n" +
      "   float r = dot(d, d) * 4.0;\n" +
      "   float intensity = max(0.0, 1.0 - r);\n" +
      "   intensity = pow(intensity, isSpark > 0.5 ? 2.4 : 1.6);\n" +
      "   vec3 hot  = vec3(1.0, 0.95, 0.55);\n" +
      "   vec3 mid  = vec3(1.0, 0.55, 0.10);\n" +
      "   vec3 cool = vec3(0.55, 0.08, 0.02);\n" +
      "   vec3 col;\n" +
      "   if (life < 0.4) col = mix(hot, mid, life / 0.4);\n" +
      "   else            col = mix(mid, cool, (life - 0.4) / 0.6);\n" +
      "   gl_FragColor = vec4(col, 1.0) * intensity * alpha;\n" +
      "}\n";

   private static ParticlesFlame instance;

   public static synchronized ParticlesFlame getInstance() {
      if (instance == null) {
         instance = new ParticlesFlame();
      }
      return instance;
   }

   private ParticlesFlame() {
      super(new Particles.Config(MAX_PARTICLES, LIFETIME,
         /*usesTint=*/false, /*blendSrc=*/770, /*blendDst=*/1,
         SHADER_NAME, VERT_SRC, FRAG_SRC));
   }

   /** Core flames sway gently; sparks drift fully with wind. Hash<0.5 = core, >=0.5 = spark. */
   @Override
   protected float windFactor(int i) {
      return this.hash[i] < 0.5F ? CORE_WIND_FACTOR : SPARK_WIND_FACTOR;
   }

   /** Spawn flame particles. `intensity` is a unitless ~0.5..1.6 scalar that drives vertical
    *  velocity (taller flames) and horizontal spread (wider base). Above 1.0 the rise scales
    *  cubically — peak burns reach ~full wall height (~1 tile) while small fires stay small. */
   public void spawn(float worldX, float worldY, float worldZ, int count, float intensity) {
      int dispatchTileX = (int)worldX;
      int dispatchTileY = (int)worldY;
      float t = this.getShaderTime();
      // Linear below 1.0 (small fires unchanged), cubic above so stage-3 peaks blow up tall.
      float power = intensity <= 1.0F ? intensity : (float)Math.pow(intensity, 3.0);
      float coreVzHi = 0.55F * power;
      float coreVzLo = 0.20F * power;
      float coreJit  = 0.10F + 0.15F * Math.max(0.0F, intensity - 1.0F);
      float sparkVzHi = Math.min(5.0F, 1.0F + 1.5F * power);
      float sparkProb = Math.min(0.30F, 0.14F + 0.06F * intensity);
      for (int i = 0; i < count; i++) {
         int idx = this.writeIdx;
         this.writeIdx = (this.writeIdx + 1) % MAX_PARTICLES;
         boolean spark = Rand.Next(0.0F, 1.0F) < sparkProb;
         float baseHash = Rand.Next(0.0F, 0.4999F);
         this.hash[idx] = spark ? baseHash + 0.5F : baseHash;
         if (spark) {
            this.x[idx] = worldX + Rand.Next(-0.10F, 0.10F);
            this.y[idx] = worldY + Rand.Next(-0.10F, 0.10F);
            this.z[idx] = worldZ + Rand.Next(0.05F, 0.20F);
            this.vx[idx] = Rand.Next(-0.20F, 0.20F);
            this.vy[idx] = Rand.Next(-0.20F, 0.20F);
            this.vz[idx] = Rand.Next(1.0F, sparkVzHi);
         } else {
            this.x[idx] = worldX + Rand.Next(-coreJit, coreJit);
            this.y[idx] = worldY + Rand.Next(-coreJit, coreJit);
            this.z[idx] = worldZ + Rand.Next(0.0F, 0.08F);
            this.vx[idx] = Rand.Next(-0.04F, 0.04F);
            this.vy[idx] = Rand.Next(-0.04F, 0.04F);
            this.vz[idx] = Rand.Next(coreVzLo, coreVzHi);
         }
         this.tileX[idx] = dispatchTileX;
         this.tileY[idx] = dispatchTileY;
         this.spawnT[idx] = t + i * 0.003F;
         this.spawnWindAccumX[idx] = NecroidParticleWind.accumX();
         this.spawnWindAccumY[idx] = NecroidParticleWind.accumY();
         this.alive[idx] = true;
      }
   }
}
